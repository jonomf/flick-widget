<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Optional, granted in Settings: lets the app picker start with the apps you used last. -->
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />
    <!-- Touch spot: Flick draws its own button on screen and keeps it ready (optional, in settings). -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Optional, asked when you add a "Call" person: start the call right away (else the dialer opens). -->
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <uses-feature android:name="android.hardware.telephony" android:required="false" />

    <queries>
        <!-- Lists your apps (with launcher icons) for the menu editor, and opens them. -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <!-- The home screen app(s), left out of "recent apps". -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.HOME" />
        </intent>
        <!-- People: dialer, SMS and WhatsApp, for opening chats/calls and showing their icons. -->
        <intent>
            <action android:name="android.intent.action.DIAL" />
            <data android:scheme="tel" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SENDTO" />
            <data android:scheme="smsto" />
        </intent>
        <!-- Links: which app opens each one (for its icon). -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="https" />
        </intent>
        <package android:name="com.android.chrome" />
        <package android:name="com.whatsapp" />
        <package android:name="com.whatsapp.w4b" />
        <!-- The Widget Updater, which checks for new builds and installs them. -->
        <package android:name="com.jono.widgetupdater" />
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/AppTheme">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Makes the widget's long-press menu show a settings entry that opens this screen. -->
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <!-- App drawer for mapping apps onto the menu by drawing their gesture. -->
        <activity
            android:name=".MapActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize|stateHidden" />

        <!-- Share a link (Chat space, Discord channel, page…) to Flick to put it on the menu. -->
        <activity
            android:name=".ShareActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:label="Add to Flick"
            android:taskAffinity=""
            android:theme="@style/Overlay">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!-- "Call X?" before a direct call. -->
        <activity
            android:name=".ConfirmCallActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:taskAffinity=""
            android:theme="@style/Overlay" />

        <!-- Adding a person: the system contact picker, then Call / Text / WhatsApp. -->
        <activity
            android:name=".PickContactActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:theme="@style/Overlay" />

        <!-- The flick overlay: see-through, over the home screen, centred on the widget. -->
        <activity
            android:name=".FlickActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleTask"
            android:taskAffinity="com.jono.flick.overlay"
            android:theme="@style/Overlay"
            android:windowSoftInputMode="stateHidden" />

        <!-- Widget shortcut taps: invisible, opens the app, closes. -->
        <activity
            android:name=".LaunchActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@style/Invisible" />

        <!-- Lets the Widget Updater find this app and tell it when a new build is out. -->
        <receiver
            android:name=".UpdateStatusReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.jono.widgets.UPDATABLE" />
            </intent-filter>
            <meta-data android:name="com.jono.widgets.repo" android:value="jonomf/flick-widget" />
            <meta-data android:name="com.jono.widgets.asset" android:value="flick-widget.apk" />
        </receiver>

        <!-- The touch spot: a floating Flick button you draw from directly. -->
        <service
            android:name=".SpotService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Floating launcher button the user draws gestures from" />
        </service>
        <receiver
            android:name=".SpotBootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- Redraws the widget every ~15 minutes (keeps the 2×1's last-used apps current). -->
        <service
            android:name=".RefreshJob"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <receiver
            android:name=".FlickWidget"
            android:exported="false"
            android:label="@string/widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info" />
        </receiver>
        <!-- App-icon long-press "Claude session" shortcut (ClaudeLink.syncShortcut) opens this. -->
        <activity
            android:name=".ClaudeLinkActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.NoDisplay" />
    </application>
</manifest>
