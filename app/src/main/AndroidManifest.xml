<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Optional, granted in Settings: lets the app picker start with the apps you used last. -->
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <queries>
        <!-- Lists your apps (with launcher icons) for the menu editor, and opens them. -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <!-- The home screen app(s), left out of "recent apps". -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.HOME" />
        </intent>
        <!-- The Widget Updater, which checks for new builds and installs them. -->
        <package android:name="com.jono.widgetupdater" />
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/AppTheme">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Makes the widget's long-press menu show a settings entry that opens this screen. -->
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <!-- App drawer for mapping apps onto the menu by drawing their gesture. -->
        <activity
            android:name=".MapActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize|stateHidden" />

        <!-- The flick overlay: see-through, over the home screen, centred on the widget. -->
        <activity
            android:name=".FlickActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleTask"
            android:taskAffinity="com.jono.flick.overlay"
            android:theme="@style/Overlay"
            android:windowSoftInputMode="stateHidden" />

        <!-- Widget shortcut taps: invisible, opens the app, closes. -->
        <activity
            android:name=".LaunchActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@style/Invisible" />

        <!-- Lets the Widget Updater find this app and tell it when a new build is out. -->
        <receiver
            android:name=".UpdateStatusReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.jono.widgets.UPDATABLE" />
            </intent-filter>
            <meta-data android:name="com.jono.widgets.repo" android:value="jonomf/flick-widget" />
            <meta-data android:name="com.jono.widgets.asset" android:value="flick-widget.apk" />
        </receiver>

        <!-- Redraws the widget every ~15 minutes (keeps the 2×1's last-used apps current). -->
        <service
            android:name=".RefreshJob"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <receiver
            android:name=".FlickWidget"
            android:exported="false"
            android:label="@string/widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info" />
        </receiver>
        <!-- App-icon long-press "Claude session" shortcut (ClaudeLink.syncShortcut) opens this. -->
        <activity
            android:name=".ClaudeLinkActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.NoDisplay" />
    </application>
</manifest>
